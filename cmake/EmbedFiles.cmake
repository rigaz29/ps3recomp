# Embed files in a C source as byte arrays.
#
#   cmake -DOUT=<file.c> -DINPUTS=<a|b|...> -DNAMES=<name_a|name_b|...> -P EmbedFiles.cmake
#
# Each name becomes `const unsigned char <name>[]`, the file's bytes followed by
# a NUL, and `const unsigned int <name>_len`, the file's size without it.
string(REPLACE "|" ";" inputs "${INPUTS}")
string(REPLACE "|" ";" names "${NAMES}")
set(text "/* Generated by cmake/EmbedFiles.cmake from the files named below. Do not edit. */\n")
list(LENGTH inputs n)
math(EXPR last "${n} - 1")
foreach(i RANGE ${last})
    list(GET inputs ${i} in)
    list(GET names ${i} name)
    file(READ "${in}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR len "${hexlen} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" bytes "${bytes}")
    get_filename_component(base "${in}" NAME)
    string(APPEND text
        "\n/* ${base} */\n"
        "extern const unsigned char ${name}[];\n"
        "extern const unsigned int ${name}_len;\n"
        "const unsigned char ${name}[] = {\n${bytes}0x00};\n"
        "const unsigned int ${name}_len = ${len}u;\n")
endforeach()
file(WRITE "${OUT}" "${text}")
